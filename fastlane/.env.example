# fastlane 시크릿 양식 파일 (이 파일만 커밋, 실제 값은 fastlane/.env 에 입력)
# 사용: cp fastlane/.env.example fastlane/.env 후 값 입력 → fastlane 실행 시 자동 로드 (fastlane/.env 는 .gitignore 처리됨)
# CI 는 같은 이름의 GitHub Actions Secret 을 쓴다. 등록: sh scripts/ci/set-secrets.sh (이 파일의 7개 값을 읽어 gh secret set, ENV_FILE=<경로> 로 다른 위치 지정 가능)
# 값에 공백·$·#·! 같은 셸 특수문자가 있으면 작은따옴표로 감싼다: KEY='값'
# 원본 값은 팀 공유 금고에 보관한다. 각 값의 출처는 README 11절 "시크릿 운영" 참고

# match 인증서 저장소(fan-maum/fanmaum-certification-ios, 브랜치 Timespread) 암호화 passphrase
MATCH_PASSWORD=

# Slack ts-qa 채널 Incoming Webhook URL (배포 성공·실패 알림)
TIMESPREAD_SLACK=

# App Store Connect API 키 (사용자 및 액세스 → 통합 → App Store Connect API). TestFlight 업로드·match 인증
# ASC_KEY_CONTENT 는 .p8 파일을 base64 한 한 줄: base64 -i AuthKey_XXXX.p8 | tr -d '\n'
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=

# Firebase App Distribution 업로드용 서비스 계정 키 JSON 한 줄 (Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성)
# 작은따옴표로 감싼다: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# 사설 리포 읽기용 GitHub PAT (cashwalk: Flutter 릴리스·XarvisSPM·SquareBanner, fan-maum: match 저장소). scope 는 repo 만
# 로컬은 scripts/install_flutter_module.sh 가 GITHUB_TOKEN 을 쓰므로 같은 값을 둘 다 두거나 셸 환경변수로 둔다
GH_PRIVATE_REPOS_TOKEN=
