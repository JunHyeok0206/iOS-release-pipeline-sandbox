digraph GitHubActionsFlow {
    rankdir=LR
    fontname="Apple SD Gothic Neo"
    node  [fontname="Apple SD Gothic Neo", fontsize=11]
    edge  [fontname="Apple SD Gothic Neo", fontsize=9, color="#555555"]

    // 브랜치
    node [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#3367D6"]
    develop [label="develop"]
    relx    [label="release-x.y.z\n(QA 수정 PR 머지 반복)"]
    release [label="release"]
    master  [label="master"]

    // make 명령어
    node [shape=box, style="rounded,filled", fillcolor="#FFF4CE", color="#B58900"]
    cmd_start  [label="make release-start\nversion=x.y.z"]
    cmd_qa     [label="make qa-deploy"]
    cmd_deploy [label="make deploy\n[lane=…]"]
    cmd_finish [label="make release-finish\n[notes=…]"]

    // 워크플로 (gh_rel 은 Makefile 이 로컬에서 실행)
    node [shape=box, style="rounded,filled", fillcolor="#F3F3F3", color="#888888"]
    wf_start  [label="Release Start\n① release-x.y.z 생성\n② release 에 머지\n③ Deploy 호출"]
    wf_deploy [label="Deploy\n① bump (버전·빌드 번호 → release 커밋)\n② build: firebase ∥ test_flight"]
    gh_rel    [label="gh release create\n태그 x.y.z + GitHub Release"]

    // 흐름
    cmd_start -> wf_start
    develop   -> wf_start [style=dashed]
    wf_start  -> relx     [style=dashed]
    wf_start  -> release  [style=dashed]
    wf_start  -> wf_deploy [label="dispatch"]

    relx    -> cmd_qa
    cmd_qa  -> release   [label="PR 머지", style=dashed]
    release -> wf_deploy [label="push 트리거"]
    cmd_deploy -> wf_deploy [label="dispatch"]

    release    -> cmd_finish
    cmd_finish -> master  [label="PR 머지", style=dashed]
    cmd_finish -> gh_rel  [label="머지 후 로컬에서 실행"]
    cmd_finish -> develop [label="back-merge\nrelease-x.y.z 삭제", style=dashed]

}
